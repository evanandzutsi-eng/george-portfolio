# Groq server-side configuration. NEVER expose GROQ_API_KEY to the frontend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Comma-separated exact frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# Optional host allow-list. Example: your-api-domain.com,localhost,127.0.0.1
TRUSTED_HOSTS=
TRUST_PROXY=false

# Abuse/resource controls.
RATE_LIMIT_PER_MINUTE=12
MAX_QUESTION_LENGTH=800
MAX_REQUEST_BYTES=16384
MAX_RESPONSE_CHARS=3500

ENVIRONMENT=development
